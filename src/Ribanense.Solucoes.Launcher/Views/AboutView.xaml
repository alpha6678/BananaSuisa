<UserControl x:Class="Ribanense.Solucoes.Launcher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.Launcher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Sobre"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}" />

            <!-- Identidade -->
            <Border Style="{StaticResource Card.Surface}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ProductName}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" />

                    <TextBlock Text="{Binding DescriptionText}"
                               Style="{StaticResource Text.Body}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="720"
                               HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Launcher" Style="{StaticResource Text.Badge}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LauncherVersionText}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SDK" Style="{StaticResource Text.Badge}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SdkVersionText}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Modo" Style="{StaticResource Text.Badge}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeploymentModeLabel}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Onde está instalado -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="INSTALAÇÃO" Style="{StaticResource Text.Section}" />

                    <TextBlock Text="Pasta do programa" Style="{StaticResource Text.FieldLabel}" />
                    <TextBlock Text="{Binding InstallDirectory}" Style="{StaticResource Text.Code}" />

                    <TextBlock Text="Executável em uso" Style="{StaticResource Text.FieldLabel}" />
                    <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource Text.Code}" />

                    <TextBlock Text="Dados do launcher" Style="{StaticResource Text.FieldLabel}" />
                    <TextBlock Text="{Binding DataRoot}" Style="{StaticResource Text.Code}" />

                    <TextBlock Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="Instalar nesta máquina, gerar cópia portátil e abrir as pastas ficam em Configurações." />
                </StackPanel>
            </Border>

            <!-- Links -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="PROJETO" Style="{StaticResource Text.Section}" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Repositório no GitHub"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenRepositoryCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Ver releases"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenReleasesCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding RepositoryUrl}"
                               Style="{StaticResource Text.Muted}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Desinstalação -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="REMOVER O LAUNCHER" Style="{StaticResource Text.Section}" />

                    <CheckBox Content="Apagar também os apps instalados e todos os dados"
                              Margin="0,10,0,0"
                              IsChecked="{Binding RemoveDataOnUninstall}" />

                    <TextBlock Text="{Binding UninstallHintText}"
                               Style="{StaticResource Text.Muted}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage, Mode=OneWay}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Success}"
                               TextWrapping="Wrap"
                               Text="{Binding StatusMessageText, Mode=OneWay}"
                               Visibility="{Binding StatusMessageText, Converter={StaticResource NullToVisibility}}" />

                    <Button Content="Desinstalar o launcher"
                            Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Command="{Binding UninstallCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
