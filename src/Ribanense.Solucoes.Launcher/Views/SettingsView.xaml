<UserControl x:Class="Ribanense.Solucoes.Launcher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.Launcher.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Configurações"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}" />
            <TextBlock Text="Ajustes do próprio launcher: atualização, forma de instalação e pastas de dados."
                       Style="{StaticResource Text.Muted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <!-- Atualização do launcher -->
            <Border Style="{StaticResource Card.Surface}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="ATUALIZAÇÃO" Style="{StaticResource Text.Section}" />

                    <TextBlock Text="{Binding UpdateStatusText}"
                               Style="{StaticResource Text.Body}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource Text.Body}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Success}"
                               Text="{Binding UpdateMessage, Mode=OneWay}"
                               Visibility="{Binding UpdateMessage, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Danger}"
                               Text="{Binding UpdateError, Mode=OneWay}"
                               Visibility="{Binding UpdateError, Converter={StaticResource NullToVisibility}}" />

                    <ProgressBar Height="8" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Verificar atualização"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding CheckUpdateCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Atualizar e reiniciar"
                                Style="{StaticResource Button.Accent}"
                                Command="{Binding UpdateLauncherCommand}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Instalação -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="INSTALAÇÃO" Style="{StaticResource Text.Section}" />

                    <DockPanel LastChildFill="False" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Abrir pasta"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenInstallFolderCommand}"
                                VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding DeploymentModeText}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding InstallDirectory}"
                                       Style="{StaticResource Text.Code}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Instalar nesta máquina"
                                Style="{StaticResource Button.Accent}"
                                Command="{Binding InstallHereCommand}"
                                Visibility="{Binding CanInstallHere, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,8,0" />
                        <Button Content="Tornar portátil"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding MakePortableCommand}"
                                Visibility="{Binding CanMakePortable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="Instalar nesta máquina copia o launcher para a pasta de programas do usuário e cria atalho no Menu Iniciar. Tornar portátil copia tudo para uma pasta à sua escolha, com dados dentro dela." />
                </StackPanel>
            </Border>

            <!-- Pastas -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="PASTAS" Style="{StaticResource Text.Section}" />

                    <DockPanel LastChildFill="False" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Abrir"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenAppsFolderCommand}"
                                VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Aplicativos instalados" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{Binding AppsUsageText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding AplicativosRoot}" Style="{StaticResource Text.Code}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Rule.Separator}" />

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Content="Abrir"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenAppDataFolderCommand}"
                                VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Dados dos apps" Style="{StaticResource Text.Body}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding AppDataUsageText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding AppDataRoot}" Style="{StaticResource Text.Code}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Rule.Separator}" />

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Right"
                                Content="Abrir"
                                Style="{StaticResource Button.Base}"
                                Command="{Binding OpenDataFolderCommand}"
                                VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Dados do launcher" Style="{StaticResource Text.Body}" Margin="0,14,0,0" />
                            <TextBlock Text="Cache do catálogo, log e preferências (Launcher.dat)."
                                       Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DataRoot}" Style="{StaticResource Text.Code}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Manutenção -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="MANUTENÇÃO" Style="{StaticResource Text.Section}" />

                    <TextBlock Style="{StaticResource Text.Body}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Limpar os dados dos apps apaga o que cada um gravou (histórico, ajustes locais). Os apps continuam instalados e voltam ao estado inicial." />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Danger}"
                               TextWrapping="Wrap"
                               Text="{Binding MaintenanceError, Mode=OneWay}"
                               Visibility="{Binding MaintenanceError, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Success}"
                               TextWrapping="Wrap"
                               Text="{Binding MaintenanceMessage, Mode=OneWay}"
                               Visibility="{Binding MaintenanceMessage, Converter={StaticResource NullToVisibility}}" />

                    <Button Content="Limpar dados dos apps"
                            Style="{StaticResource Button.Danger}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Command="{Binding ClearAppDataCommand}" />
                </StackPanel>
            </Border>

            <!-- Catálogo -->
            <Border Style="{StaticResource Card.Surface}">
                <StackPanel>
                    <TextBlock Text="CATÁLOGO" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="Endereço do catalog.json usado para listar os apps."
                               Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CatalogUrl}" Style="{StaticResource Text.Code}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="Variáveis de ambiente aceitas: RIBANENSE_CATALOG_URL, RIBANENSE_LAUNCHER_DATA, RIBANENSE_APLICATIVOS_ROOT." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
