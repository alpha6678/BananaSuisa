<UserControl x:Class="Ribanense.Solucoes.App.Farol.Views.DossierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Farol.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DossierViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Capturar agora"
                    Style="{StaticResource Button.Accent}"
                    Command="{Binding CaptureCommand}" />
            <Button Content="Exportar ZIP"
                    Margin="8,0,0,0"
                    Style="{StaticResource Button.Base}"
                    Command="{Binding ExportCommand}" />
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Muted}"
                       Text="{Binding CaptureLabel}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Text.Muted}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding CollectorsLabel}" />
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource Panel.Surface}"
                VerticalAlignment="Top"
                Visibility="{Binding HasBundle, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Ainda sem dossiê" />
                <TextBlock Style="{StaticResource Text.Muted}"
                           Text="Capturar agora lê identidade, rede, discos, serviços críticos, impressoras, eventos recentes do Windows e o estado dos outros apps Ribanense. Nada é alterado na máquina." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding HasBundle, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Panel.Surface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Resumo" />
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                            <Border Style="{StaticResource Panel.Surface}"
                                    BorderThickness="4,1,1,1"
                                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SeverityLabel}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Category}"
                                                   Margin="10,0,0,0"
                                                   Style="{StaticResource Text.Muted}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <TextBlock Text="{Binding Evidence}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />

                                    <Expander Header="O que fazer" Margin="0,8,0,0"
                                              IsExpanded="{Binding IsExpanded}">
                                        <TextBlock Text="{Binding Suggestion}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
