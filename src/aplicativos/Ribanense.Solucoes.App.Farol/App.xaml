<Application x:Class="Ribanense.Solucoes.App.Farol.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ribanense.Solucoes.App.Farol.Converters"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Farol.ViewModels"
             xmlns:views="clr-namespace:Ribanense.Solucoes.App.Farol.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ribanense.Solucoes.App.Farol;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/Breakpoints.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:PeerStateToBrushConverter x:Key="PeerStateToBrush" />
            <conv:HealthLevelToBrushConverter x:Key="HealthLevelToBrush" />

            <DataTemplate DataType="{x:Type vm:MapViewModel}">
                <views:MapView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DossierViewModel}">
                <views:DossierView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompareViewModel}">
                <views:CompareView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
