<UserControl x:Class="Ribanense.Solucoes.App.Recuperacao.Views.ReparoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Recuperacao.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioReparoViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="Executar reparo seguro"
                        Style="{StaticResource Button.Accent}"
                        Command="{Binding ExecutarCommand}"
                        Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource Button.Base}"
                        Command="{Binding CancelarCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="14"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Progresso}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Pular SFC /scannow"
                          IsChecked="{Binding SkipSfc}"
                          Margin="0,0,16,0" />
                <CheckBox Content="Pular DISM /RestoreHealth"
                          IsChecked="{Binding SkipDism}" />
            </StackPanel>
            <TextBlock Text="{Binding ResultadoFinal}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Passos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0"
                                     Width="10" Height="10"
                                     Fill="{Binding Estado, Converter={StaticResource PassoEstadoToBrush}}"
                                     VerticalAlignment="Top"
                                     Margin="0,5,8,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detalhe, FallbackValue=''}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Visibility="{Binding Detalhe, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
