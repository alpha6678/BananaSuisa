<UserControl x:Class="Ribanense.Solucoes.App.Recuperacao.Views.EscaladaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Recuperacao.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioEscaladaViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Border Style="{StaticResource Badge.Danger}">
                <TextBlock Text="Fase destrutiva: desinstala e apaga drivers do Driver Store. Só use depois do backup — sem ele, não há volta."
                           TextWrapping="Wrap" />
            </Border>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Left"
                        Content="Carregar drivers MEDIA"
                        Style="{StaticResource Button.Accent}"
                        Command="{Binding CarregarDriversCommand}"
                        Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left"
                        Content="Remover selecionados"
                        Style="{StaticResource Button.Danger}"
                        Command="{Binding RemoverSelecionadosCommand}"
                        Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource Button.Base}"
                        Command="{Binding CancelarCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="14"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Progresso}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nenhum driver MEDIA de terceiros listado. Use “Carregar drivers MEDIA”."
                           Foreground="{StaticResource Brush.TextMuted}"
                           Visibility="{Binding TemDrivers, Converter={StaticResource InverseBoolToVis}}"
                           Margin="4,0,0,8" />
                <ItemsControl ItemsSource="{Binding Drivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selecionado}"
                                      Content="{Binding Rotulo}"
                                      Margin="4,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Expander Grid.Row="2"
                  Header="Guia: reparo in-place (mantém arquivos e aplicativos, não formata)"
                  Background="{StaticResource Brush.Surface}"
                  BorderBrush="{StaticResource Brush.Border}"
                  BorderThickness="1"
                  Padding="8"
                  Margin="0,8,0,0">
            <TextBlock Text="{Binding GuiaInPlace}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="12" />
        </Expander>
    </Grid>
</UserControl>
