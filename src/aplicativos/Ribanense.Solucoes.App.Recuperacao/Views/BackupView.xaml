<UserControl x:Class="Ribanense.Solucoes.App.Recuperacao.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Recuperacao.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AudioBackupViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="Executar backup"
                        Style="{StaticResource Button.Accent}"
                        Command="{Binding ExecutarCommand}"
                        Margin="0,0,8,0" />
                <Button DockPanel.Dock="Left"
                        Content="Cancelar"
                        Style="{StaticResource Button.Base}"
                        Command="{Binding CancelarCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="160" Height="14"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Progresso}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StatusText}"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding CaminhoManifesto, FallbackValue=''}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Visibility="{Binding CaminhoManifesto, Converter={StaticResource NullToVis}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Itens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Badge.Surface}">
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detalhe, FallbackValue=''}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Visibility="{Binding Detalhe, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
