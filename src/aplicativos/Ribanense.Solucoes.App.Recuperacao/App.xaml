<Application x:Class="Ribanense.Solucoes.App.Recuperacao.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ribanense.Solucoes.App.Recuperacao.Converters"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Recuperacao.ViewModels"
             xmlns:views="clr-namespace:Ribanense.Solucoes.App.Recuperacao.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ribanense.Solucoes.App.Recuperacao;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/Breakpoints.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:CheckSeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:PassoEstadoToBrushConverter x:Key="PassoEstadoToBrush" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"
                xmlns:converters="clr-namespace:Ribanense.Solucoes.UI.Converters;assembly=Ribanense.Solucoes.UI" />

            <DataTemplate DataType="{x:Type vm:AudioViewModel}">
                <views:AudioView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioDiagnosticoViewModel}">
                <views:DiagnosticoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioBackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioReparoViewModel}">
                <views:ReparoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioEscaladaViewModel}">
                <views:EscaladaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioCodecViewModel}">
                <views:CodecView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
