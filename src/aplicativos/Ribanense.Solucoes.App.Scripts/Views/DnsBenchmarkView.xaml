<UserControl x:Class="Ribanense.Solucoes.App.Scripts.Views.DnsBenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Scripts.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DnsBenchmarkViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- Descrição -->
        <Border Grid.Row="0" Style="{StaticResource Badge.Surface}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Text="Testar melhor DNS para a rede" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"
                           Text="Mede a latência real de resolução de nomes contra cada servidor DNS (consulta direta via UDP, sem usar o cache do sistema) e ranqueia pelo melhor tempo médio e taxa de sucesso." />
            </StackPanel>
        </Border>

        <!-- Seleção de servidores -->
        <Border Grid.Row="1" Style="{StaticResource Badge.Surface}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Servidores a testar" />

                <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DnsServerSelectionViewModel}">
                            <Border Background="{StaticResource Brush.Background}"
                                    CornerRadius="4"
                                    Margin="0,0,8,8"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Content="{Binding Label}" />
                                    <TextBlock Text="{Binding IpAddress, StringFormat=' ({0})'}"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0" />
                                    <Button Content="✕"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="6,0,0,0"
                                            Padding="4,0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            ToolTip="Remover DNS personalizado" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="DNS personalizado:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="160"
                             Text="{Binding CustomDnsInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6"
                             VerticalContentAlignment="Center" />
                    <Button Content="Adicionar"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Base}"
                            Command="{Binding AddCustomDnsCommand}" />
                    <Button Content="Testar"
                            Margin="16,0,0,0"
                            Style="{StaticResource Button.Accent}"
                            Command="{Binding RunCommand}" />
                    <Button Content="Cancelar"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Base}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Resultados -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedResult}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                    <DataGridTextColumn Header="Servidor" Binding="{Binding Label}" Width="140" />
                    <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="130" />
                    <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="140" />
                    <DataGridTextColumn Header="Média" Binding="{Binding AverageDisplay}" Width="80" />
                    <DataGridTextColumn Header="Mediana" Binding="{Binding MedianDisplay}" Width="80" />
                    <DataGridTextColumn Header="Sucesso" Binding="{Binding SuccessDisplay}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWinner}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Success.Bg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>

        <!-- Aplicar DNS -->
        <Border Grid.Row="3"
                Style="{StaticResource Badge.Surface}"
                Visibility="{Binding SelectedResult, Converter={StaticResource NullToVis}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Aplicar DNS selecionado na rede (requer administrador)" />
                <Border Background="{StaticResource Brush.Background}"
                        CornerRadius="3"
                        Padding="8,4"
                        Margin="0,6,0,6">
                    <TextBlock FontFamily="Consolas"
                               FontSize="11"
                               Text="{Binding ApplyCommandPreview}"
                               TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Copiar comando"
                            Style="{StaticResource Button.Base}"
                            Command="{Binding CopyApplyCommandCommand}" />
                    <Button Content="Aplicar automaticamente"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Accent}"
                            Command="{Binding ApplyDnsCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Terminal / log em tempo real -->
        <Border Grid.Row="4"
                Background="{StaticResource Brush.LogBg}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Terminal"
                           Foreground="{StaticResource Brush.LogText}"
                           Margin="12,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.LogText}"
                                           Margin="12,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
