<Application x:Class="Ribanense.Solucoes.App.Scripts.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ribanense.Solucoes.App.Scripts.Converters"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Scripts.ViewModels"
             xmlns:views="clr-namespace:Ribanense.Solucoes.App.Scripts.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ribanense.Solucoes.App.Scripts;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/Breakpoints.xaml" />
                <ResourceDictionary Source="/Ribanense.Solucoes.UI;component/Styles/DataGrid.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />

            <DataTemplate DataType="{x:Type vm:DnsBenchmarkViewModel}">
                <views:DnsBenchmarkView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
