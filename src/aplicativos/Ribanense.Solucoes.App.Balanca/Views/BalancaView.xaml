<UserControl x:Class="Ribanense.Solucoes.App.Balanca.Views.BalancaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Ribanense.Solucoes.App.Balanca.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:BalancaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Section.Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>

        <Style x:Key="Step.Header" TargetType="TextBlock" BasedOn="{StaticResource Section.Header}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Text.Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Roteiro: porta -> modelo -> teste -->
        <Border Grid.Column="0"
                Style="{StaticResource Badge.Surface}"
                MinWidth="380" MaxWidth="460"
                Margin="0,0,16,0"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- PASSO 1: porta -->
                    <TextBlock Style="{StaticResource Step.Header}" Text="1. Porta do equipamento" />
                    <TextBlock Style="{StaticResource Text.Hint}"
                               Text="No caixa costumam aparecer duas ou três portas COM. A da maquininha TEF em geral é a de link Bluetooth; a balança costuma estar num adaptador USB-serial ou na COM da placa." />

                    <ListBox ItemsSource="{Binding Ports}"
                             SelectedItem="{Binding SelectedPort}"
                             MaxHeight="180"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding DeviceManagerLabel}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RoleHint}"
                                               Foreground="{StaticResource Brush.TextMuted}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusHint}"
                                               Foreground="{StaticResource Brush.Warning}"
                                               FontSize="11"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Atualizar"
                                Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                                Command="{Binding RefreshPortsCommand}" />
                        <TextBlock Text="{Binding PortsSummary}"
                                   Style="{StaticResource Text.Hint}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding SelectedPortHint}"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,8,0,0" />

                    <!-- PASSO 2: modelo -->
                    <TextBlock Style="{StaticResource Step.Header}" Margin="0,16,0,4" Text="2. Modelo da balança" />
                    <TextBlock Style="{StaticResource Text.Hint}"
                               Text="Identifique a marca gravada na balança. O app aplica a configuração serial documentada desse modelo." />
                    <ComboBox ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              DisplayMemberPath="Label" />
                    <TextBlock Text="{Binding ModelNotes}"
                               Style="{StaticResource Text.Hint}"
                               Margin="0,8,0,0" />

                    <DockPanel LastChildFill="True" Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Restaurar sugerida"
                                Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                                Command="{Binding UseSuggestedConfigCommand}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label.Field}" Text="Configuração em uso" />
                            <TextBlock Text="{Binding CurrentConfigText}" FontFamily="Consolas" />
                        </StackPanel>
                    </DockPanel>

                    <!-- PASSO 3: testar -->
                    <TextBlock Style="{StaticResource Step.Header}" Margin="0,16,0,4" Text="3. Testar a leitura" />
                    <WrapPanel>
                        <Button Content="Ativar" Style="{StaticResource Button.Accent}" Margin="0,0,8,8"
                                Command="{Binding ActivateCommand}" />
                        <Button Content="Ler peso" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Command="{Binding ReadWeightCommand}" />
                        <Button Content="{Binding MonitorButtonText}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Command="{Binding ToggleMonitorCommand}" />
                        <Button Content="Desativar" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Command="{Binding DeactivateCommand}" />
                        <Button Content="Limpar" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Command="{Binding ClearCommand}" />
                    </WrapPanel>

                    <Border Background="{StaticResource Brush.Warning.Bg}"
                            BorderBrush="{StaticResource Brush.Warning}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,4,0,0"
                            Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Tentar outras configurações" Style="{StaticResource Button.Accent}"
                                        Margin="0,0,8,0"
                                        Command="{Binding StartScanCommand}" />
                                <Button Content="Parar" Style="{StaticResource Button.Base}"
                                        Command="{Binding StopScanCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- AVANÇADO: parâmetros manuais e varredura ampla -->
                    <Expander Header="Avançado: parâmetros e varredura ampla"
                              IsExpanded="{Binding ShowAdvanced}"
                              Margin="0,16,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Baud rate" />
                                    <ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Data bits" />
                                    <ComboBox ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Paridade" />
                                    <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Stop bits" />
                                    <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Handshake" />
                                    <ComboBox ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding Handshake}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Label.Field}" Text="Timeout (ms)" />
                                    <TextBox Text="{Binding TimeoutMs}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding ScanAllPorts}"
                                      Content="Varrer todas as portas (e não só a escolhida)" />
                            <CheckBox Margin="0,6,0,0"
                                      IsChecked="{Binding DeepScan}"
                                      Content="Varredura profunda (mais bauds/paridades/stop bits)" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Varrer combinações agora" Style="{StaticResource Button.Base}" Margin="0,0,8,0"
                                        Command="{Binding StartScanCommand}" />
                                <Button Content="Parar" Style="{StaticResource Button.Base}"
                                        Command="{Binding StopScanCommand}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Section.Header}" Margin="0,16,0,4" Text="Passo a passo" />
                            <TextBlock Style="{StaticResource Text.Hint}"
                                       Text="Testa uma combinação por vez, para acompanhar o visor da balança a cada tentativa." />
                            <TextBlock Text="{Binding CurrentCandidateText}" FontFamily="Consolas" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StepProgress}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Iniciar" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                        Command="{Binding StartStepCommand}" />
                                <Button Content="Próximo" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                        Command="{Binding NextStepCommand}" />
                                <Button Content="Usar esta config" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                        Command="{Binding UseCurrentConfigCommand}" />
                                <Button Content="Parar" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"
                                        Command="{Binding StopScanCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Leitura e resultados -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Badge.Surface}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label.Field}" Text="Último peso lido" />
                    <TextBlock Style="{StaticResource Text.Weight}" Text="{Binding WeightDisplay}" />
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" Text="{Binding StatusText}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Badge.Surface}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label.Field}" Text="Última resposta (ASCII)" />
                    <TextBox Text="{Binding LastResponseAscii, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                             TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Label.Field}" Text="Última resposta (HEX)" />
                    <TextBox Text="{Binding LastResponseHex, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" BorderThickness="0" Background="Transparent"
                             TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScanProgress}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Badge.Surface}" Padding="0" Margin="0,0,0,0"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section.Header}"
                               Margin="14,10,0,6" Text="Configurações que responderam" />
                    <DataGrid ItemsSource="{Binding ScanResults}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Configuração" Width="*"
                                                Binding="{Binding Config.ShortDescription}" />
                            <DataGridTextColumn Header="Peso"
                                                Binding="{Binding Reading.Weight, StringFormat=0.000}" />
                            <DataGridTextColumn Header="Unid."
                                                Binding="{Binding Reading.Unit}" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Reading.StatusText}" />
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Usar"
                                                Style="{StaticResource Button.Accent}"
                                                Margin="4,2"
                                                Command="{Binding DataContext.UseResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
